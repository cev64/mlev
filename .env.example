# The Odds API key, used only by fetch_odds_data.py.
# Sign up at https://the-odds-api.com/ for a free tier key.
# Nothing in sports/ or core/ reads this: market data is deliberately
# out of scope for the modelling pipeline right now.
ODDS_API_KEY=your_key_here

# Optional override for where pipeline data is written (defaults to ./data)
# MLEV_DATA_DIR=/absolute/path/to/data
